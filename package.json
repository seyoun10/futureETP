{
  "name": "futureetp",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test --workspaces --if-present",
    "test:gate": "npm run test -w apps/server -- --coverage && npm run test -w packages/shared -- --coverage && npm run test -w apps/mobile",
    "check": "npm run typecheck && npm run lint && npm run knip && npm run check:migrations && npm run format:check && npm run test:gate",
    "test:coverage": "bash scripts/test-coverage.sh",
    "prepare": "husky",
    "access-key": "node scripts/access-key.mjs",
    "perf:collect": "node scripts/perf-collect.mjs",
    "mirror": "bash scripts/mirror.sh",
    "deploy": "bash scripts/deploy.sh",
    "deploy:rollback": "bash scripts/rollback.sh",
    "deploy:status": "bash scripts/deploy-status.sh",
    "distribute:android": "bash scripts/distribute-android.sh",
    "update:prod": "bash scripts/release-guard.sh && npm run update:prod -w apps/mobile -- --message \"$(git log -1 --pretty=%s)\"",
    "backup:pull": "bash scripts/backup-pull.sh",
    "secrets:backup": "bash scripts/secrets-backup.sh",
    "batch:result": "bash scripts/batch-result.sh",
    "dev:restore": "bash scripts/dev-restore.sh",
    "prod:seed": "bash scripts/prod-seed.sh",
    "check:migrations": "bash scripts/check-migrations.sh",
    "knip": "knip",
    "deps:watch": "node scripts/deps-watch.mjs",
    "ci:wait": "bash scripts/ci-wait.sh"
  },
  "overrides": {
    "react": "19.3.0",
    "react-native": "0.88.1"
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-prettier": "^10.1.8",
    "fast-check": "^4.10.2",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "knip": "^6.45.1",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "toqr": "0.1.1",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
