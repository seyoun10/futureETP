{
  "name": "futureetp",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test --workspaces --if-present",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test",
    "prepare": "husky",
    "access-key": "node scripts/access-key.mjs",
    "perf:collect": "node scripts/perf-collect.mjs",
    "mirror": "bash scripts/mirror.sh",
    "deploy": "bash scripts/deploy.sh",
    "distribute:android": "bash scripts/distribute-android.sh",
    "update:prod": "npm run update:prod -w apps/mobile -- --message \"$(git log -1 --pretty=%s)\"",
    "backup:pull": "bash scripts/backup-pull.sh",
    "dev:restore": "bash scripts/dev-restore.sh",
    "prod:seed": "bash scripts/prod-seed.sh"
  },
  "overrides": {
    "react": "19.3.0",
    "react-native": "0.88.0"
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "toqr": "0.1.1",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
