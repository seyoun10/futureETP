# prod 환경 변수. VM에서 infra/.env로 복사해 채우고 chmod 600 (저장소·rsync 제외, D-043)
# NODE_ENV·PORT·DATABASE_URL·SCHEDULER_ENABLED·FCM_SERVICE_ACCOUNT_PATH·BACKUP_DIR은 docker-compose.yml이 고정한다

# Caddy가 TLS를 받을 호스트명(D-036)
DOMAIN=futureetp.invalid
# DATABASE_URL에 그대로 들어가므로 URL에 안전한 문자만(예: openssl rand -hex 32)
POSTGRES_PASSWORD=
# 앱 접근 키(32자 이상, npm run access-key로 생성, D-044)
API_TOKEN=
LOG_LEVEL=info

# 외부 소스 키(dev와 같은 키)
DATABENTO_API_KEY=
MASSIVE_API_KEY=
KRX_API_KEY=
# Healthchecks.io 프로젝트 ping key(D-045)
HEALTHCHECKS_PING_KEY=

# FCM 서비스 계정 키는 infra/secrets/fcm-service-account.json에 둔다(권한 600)
