{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "market": {
      "type": "string",
      "enum": [
        "KRX",
        "US"
      ]
    },
    "type": {
      "type": "string",
      "enum": [
        "ETF",
        "ETN"
      ]
    },
    "leverage": {
      "type": "number"
    },
    "fxHedge": {
      "type": "string",
      "enum": [
        "HEDGED",
        "UNHEDGED",
        "NA"
      ]
    },
    "name": {
      "type": "string"
    },
    "tickers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "aum": {
      "type": [
        "number",
        "null"
      ]
    },
    "avgTradingValue": {
      "type": [
        "number",
        "null"
      ]
    },
    "commodityCode": {
      "type": "string",
      "enum": [
        "GC",
        "SI",
        "CL",
        "NG"
      ]
    },
    "nameLang": {
      "type": "string",
      "enum": [
        "ko",
        "en"
      ]
    },
    "issuer": {
      "type": [
        "string",
        "null"
      ]
    },
    "underlyingIndex": {
      "type": [
        "string",
        "null"
      ]
    },
    "expenseRatio": {
      "type": [
        "number",
        "null"
      ]
    },
    "issuerUrl": {
      "type": [
        "string",
        "null"
      ]
    },
    "listedDate": {
      "anyOf": [
        {
          "type": "string",
          "format": "date",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
        },
        {
          "type": "null"
        }
      ]
    },
    "series": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "ticker": {
            "type": "string"
          },
          "seriesCode": {
            "type": [
              "string",
              "null"
            ]
          },
          "maturityDate": {
            "anyOf": [
              {
                "type": "string",
                "format": "date",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "ticker",
          "seriesCode",
          "maturityDate"
        ]
      }
    },
    "collectedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    }
  },
  "required": [
    "id",
    "market",
    "type",
    "leverage",
    "fxHedge",
    "name",
    "tickers",
    "aum",
    "avgTradingValue",
    "commodityCode",
    "nameLang",
    "issuer",
    "underlyingIndex",
    "expenseRatio",
    "issuerUrl",
    "listedDate",
    "series",
    "collectedAt"
  ],
  "title": "etpDetail"
}
