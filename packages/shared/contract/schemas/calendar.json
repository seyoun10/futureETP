{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "from": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
    },
    "to": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
    },
    "exceptions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "market": {
            "type": "string",
            "enum": [
              "CME",
              "KRX",
              "NYSE"
            ]
          },
          "date": {
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "CLOSED",
              "HALT",
              "EARLY_CLOSE",
              "LATE_OPEN"
            ]
          },
          "at": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\d{2}:\\d{2}$"
              },
              {
                "type": "null"
              }
            ],
            "description": "그 시장 현지 시각 HH:mm(CME CT, KRX KST, NYSE ET). CLOSED는 null"
          },
          "note": {
            "type": "string",
            "description": "휴일 이름. 입력 원문(CME·NYSE 영어, KRX 한국어)"
          }
        },
        "required": [
          "market",
          "date",
          "kind",
          "at",
          "note"
        ]
      }
    },
    "missing": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "market": {
            "type": "string",
            "enum": [
              "CME",
              "KRX",
              "NYSE"
            ]
          },
          "year": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "market",
          "year"
        ]
      },
      "description": "범위에 걸친 연도 중 휴장 일정이 입력되지 않은 (시장, 연도)"
    }
  },
  "required": [
    "from",
    "to",
    "exceptions",
    "missing"
  ],
  "title": "calendar"
}
