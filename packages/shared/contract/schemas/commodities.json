{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "freshness": {
      "type": "object",
      "properties": {
        "asOf": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        "tradeDate": {
          "type": "string",
          "format": "date",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
        },
        "delayed": {
          "type": "boolean"
        },
        "marketState": {
          "type": "string",
          "enum": [
            "OPEN",
            "CLOSED",
            "SETTLEMENT_PENDING"
          ]
        },
        "nextUpdateAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "asOf",
        "tradeDate",
        "delayed",
        "marketState",
        "nextUpdateAt"
      ]
    },
    "commodities": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "GC",
              "SI",
              "CL",
              "NG"
            ]
          },
          "priceDecimals": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "alert": {
            "type": "boolean"
          },
          "contracts": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "symbol": {
                  "type": "string"
                },
                "contractMonth": {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}$"
                },
                "price": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "change": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "changePct": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "noTrade": {
                  "type": "boolean"
                },
                "isFront": {
                  "type": "boolean"
                }
              },
              "required": [
                "symbol",
                "contractMonth",
                "price",
                "change",
                "changePct",
                "noTrade",
                "isFront"
              ]
            }
          }
        },
        "required": [
          "code",
          "priceDecimals",
          "alert",
          "contracts"
        ]
      }
    }
  },
  "required": [
    "freshness",
    "commodities"
  ],
  "title": "commodities"
}
