{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "basis": {
      "type": "string",
      "enum": [
        "FRONT",
        "KR",
        "US"
      ]
    },
    "ma": {
      "type": "string",
      "enum": [
        "20",
        "50",
        "100",
        "200"
      ]
    },
    "window": {
      "type": "string",
      "enum": [
        "Y3",
        "Y5",
        "Y10",
        "ALL"
      ]
    },
    "levels": {
      "type": "string",
      "pattern": "^\\d+(\\.\\d+)?(,\\d+(\\.\\d+)?)*$",
      "description": "rare 레벨 5개를 쉼표로(예: 1,2.5,5,10,20). 설정 rareLevels와 같은 규칙"
    },
    "before": {
      "description": "이 거래일보다 이른 데이터만(이전 3년 더 받기, D-104). 없으면 최근 3년",
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
    }
  },
  "required": [
    "basis",
    "ma",
    "window",
    "levels"
  ],
  "title": "disparityQuery"
}
