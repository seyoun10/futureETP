# dev 서버 환경 변수. .env로 복사해서 쓴다(커밋 안 함). prod는 VM의 infra/.env (D-043)
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://localhost:5432/futureetp
# 앱 접근 키(32자 이상). 앱 dev 변형의 DEV_API_TOKEN과 같은 값
API_TOKEN=change-me-to-a-random-string-of-32-chars-or-more
# dev는 끈다. 작업은 npm run job -- <작업 이름>으로 1회 실행
SCHEDULER_ENABLED=false
LOG_LEVEL=debug

# 외부 소스 키(prod와 같은 키). 비우면 그 소스를 쓰는 작업만 실패한다
DATABENTO_API_KEY=
MASSIVE_API_KEY=
KRX_API_KEY=
# FCM 서비스 계정 키 JSON 파일 경로(저장소 밖)
FCM_SERVICE_ACCOUNT_PATH=
# dev는 비워서 Healthchecks.io 신호를 보내지 않는다
HEALTHCHECKS_PING_KEY=
# BACKUP 작업의 덤프 폴더(prod 전용)
BACKUP_DIR=
