{
  "name": "@futureetp/mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "APP_VARIANT=development expo start",
    "prebuild:dev": "APP_VARIANT=development expo prebuild --clean",
    "prebuild:prod": "APP_VARIANT=production expo prebuild --clean",
    "android:dev": "npm run prebuild:dev -- --platform android && APP_VARIANT=development expo run:android",
    "android:release": "npm run prebuild:prod -- --platform android && APP_VARIANT=production expo run:android --variant release",
    "ios:dev": "npm run prebuild:dev -- --platform ios && APP_VARIANT=development expo run:ios",
    "update:prod": "APP_VARIANT=production eas update --channel production --environment production",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "expo": "~58.0.19",
    "expo-constants": "~58.0.13",
    "expo-linking": "~58.0.14",
    "expo-router": "~58.0.26",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  }
}
